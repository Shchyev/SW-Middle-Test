@prefix ex: <http://example.org/mkr/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Flight
    a rdfs:Class .

ex:Airline
    a rdfs:Class .

ex:City
    a rdfs:Class .

ex:Country
    a rdfs:Class .

ex:Source
    a rdfs:Class .

ex:BudgetFlight
    a rdfs:Class ;
    rdfs:subClassOf ex:Flight .

ex:LongFlight
    a rdfs:Class ;
    rdfs:subClassOf ex:Flight .

ex:operatedBy
    a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:Airline .

ex:departsFrom
    a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:City .

ex:arrivesAt
    a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:City .

ex:locatedIn
    a rdf:Property ;
    rdfs:domain ex:City ;
    rdfs:range ex:Country .

ex:departureDate
    a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:date .

ex:durationMin
    a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:integer .

ex:priceEur
    a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:decimal .

ex:hasDelayMinutes
    a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:integer .

ex:reportedBy
    a rdf:Property ;
    rdfs:domain rdf:Statement ;
    rdfs:range ex:Source .

ex:fromBusyCountry
    a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:boolean .

<http://example.org/mkr/flight/FL-1615>
    a ex:BudgetFlight ;
    ex:operatedBy <http://example.org/mkr/airline/SkyNord> ;
    ex:departsFrom <http://example.org/mkr/city/Riga> ;
    ex:arrivesAt <http://example.org/mkr/city/Odesa> ;
    ex:departureDate "2026-04-15"^^xsd:date ;
    ex:durationMin "185"^^xsd:integer ;
    ex:priceEur "53.00"^^xsd:decimal .

<http://example.org/mkr/flight/FL-1830>
